DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*

# Leave DB_ENGINE as sqlite3 for local dev, or switch to Postgres:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

REDIS_URL=redis://localhost:6379/0
AI_SERVICE_BASE_URL=http://localhost:9000
CORS_ALLOW_ALL_ORIGINS=True

# Development prints OTP emails to the runserver console. Set this to Django's
# SMTP backend and provide its settings when deploying real email delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@medicalpanda.local
# Example production values:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-email-app-password
# EMAIL_USE_TLS=True
